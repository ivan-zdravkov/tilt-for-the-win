# Single source of truth for toolchain versions.
# Android values must match the targetSdk of the pinned Godot version (4.7.2 targets API 36).
# Read by tools/setup-dev.sh, tools/*.sh and the GitHub Actions workflows. Upgrade deliberately, all at once.
GODOT_VERSION=4.7.2
GDUNIT4_VERSION=6.2.1
ANDROID_PLATFORM=android-36
ANDROID_BUILD_TOOLS=36.1.0
ANDROID_NDK=28.1.13356709
ANDROID_CMAKE=3.10.2.4988404
CMDLINE_TOOLS_ZIP=commandlinetools-linux-13114758_latest.zip
